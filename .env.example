# TheKeralaStore Environment Configuration
# Copy this file to .env and fill in your Supabase credentials

# Supabase Project Credentials (Dashboard > Project Settings > API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Razorpay Online Payments (Dashboard > Settings > API Keys)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret
VITE_RAZORPAY_KEY_ID=rzp_test_your_key_id

